{
  "name": "CPRv - Operacional",
  "displayName": "CPRv - Operacional",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",

  "splash": {
    "image": "./src/assets/logo-cprv.png",
    "resizeMode": "contain",
    "backgroundColor": "#FFFFFF"
  },

  "android": {
    "package": "com.anonymous.appcprv"
